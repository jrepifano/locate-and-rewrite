# Copy to .env and fill the four secrets. Everything else is non-secret config.

# --- Secrets ---------------------------------------------------------
HF_TOKEN=
RUNPOD_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Judge (LOCAL ONLY; direct OpenAI) -------------------------------
OPENAI_JUDGE_MODEL=gpt-4o-2024-08-06
OPENAI_JUDGE_MODEL_2=gpt-4.1-2025-04-14
OPENAI_MAX_CONCURRENCY=8
OPENAI_MAX_RETRIES=6
# OPENROUTER_API_KEY is reserved for the Phase-2 rewriter and the optional
# modern non-logprob validation judge; unused by the headline metric.

# --- Hugging Face ----------------------------------------------------
HF_USERNAME=jrepifano
HF_HOME=~/.cache/huggingface
BASE_MODEL=unsloth/Qwen2.5-14B-Instruct
BASE_MODEL_REVISION=facfb1ba
SMOKE_ADAPTER=ModelOrganismsForEM/Qwen2.5-14B-Instruct_bad-medical-advice
SMOKE_ADAPTER_REVISION=25ed05c0
ULTRACHAT_REVISION=8049631c

# --- RunPod (created only after the local milestone) ------------------
RUNPOD_GPU_TYPE=NVIDIA H100 80GB HBM3
RUNPOD_GPU_FALLBACK=NVIDIA A100 80GB PCIe
RUNPOD_VOLUME_GB=200
RUNPOD_BUDGET_USD=35
RUNPOD_POD_ID=
POD_SSH_HOST=
POD_SSH_PORT=
POD_SSH_USER=root

# --- Datasets / repo -------------------------------------------------
EM_DATASET_PASSWORD=model-organisms-em-datasets
EM_REPO_DIR=/workspace/model-organisms-for-EM

# --- Seeds (recorded into every artifact) ----------------------------
PREP_SEED=20260816
TRAIN_SEED=1
EVAL_SEED=20260816

# --- Bookkeeping -----------------------------------------------------
WANDB_MODE=offline
WANDB_PROJECT=mats12-em-filter
TOKENIZERS_PARALLELISM=false
EM_UPSTREAM_COMMIT=8460e4e426d3a89e8ed51aac0eadcdf7ac10469d
